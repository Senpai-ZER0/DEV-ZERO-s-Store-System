              <ShowInInventory>true</ShowInInventory>
              <NumberInGrid>3</NumberInGrid>
              <Enabled>true</Enabled>
              <Program>//Inventory Viewer v2.1.1
//02.06.2021

const string LCD_TAG = "[LCD_CARGO]";

static Dictionary&lt;char, string[]&gt; Font = new Dictionary&lt;char, string[]&gt;();
static Dictionary&lt;char, string[]&gt; SFont = new Dictionary&lt;char, string[]&gt;();
static Dictionary&lt;string, string[]&gt; Images = new Dictionary&lt;string, string[]&gt;();

List&lt;LCDGroup&gt; Groups = new List&lt;LCDGroup&gt;();

Program()
{
    Runtime.UpdateFrequency = UpdateFrequency.Update10;
}

public void Main(string argument, UpdateType updateType)
{
    if (updateType != UpdateType.Update10) return;

    if (!decoded) { Decode(); return; }
    if (!custom_decoded) { DecodeCustomImages(); return; }

    SearchLCD();
    DoWork();
}

DateTime lastSearch = DateTime.Now.Date;

void SearchLCD()
{
    if (lastSearch &gt; DateTime.Now.AddSeconds(-1)) return;
    else lastSearch = DateTime.Now;

    List&lt;IMyTerminalBlock&gt; Blocks = new List&lt;IMyTerminalBlock&gt;();
    GridTerminalSystem.SearchBlocksOfName(LCD_TAG, Blocks);

    var Panels = Blocks.Where(a =&gt; a is IMyTextPanel).Select(a =&gt; new { cn = LCDConfig.CargoNameFromConfig(a.CustomData), p = a }).ToArray();

    List&lt;LCDGroup&gt; nList = new List&lt;LCDGroup&gt;();

    foreach (var P in Panels)
    {
        if (P.cn.name.Contains(LCD_TAG))
        {
            if (!Panels.Any(a =&gt; a.p.CustomName == P.cn.name))
            {
                new LCDGroup(new List&lt;MyPanel&gt;() { new MyPanel(P.p) }, P.cn.name, GridTerminalSystem)
                            .ShowError("Primary panel not found");
            }
            continue;
        }

        var G = Groups.SingleOrDefault(a =&gt; a.Panels[0].Lcd.Equals(P.p));
        if (G == null)
        {
            var PL = new List&lt;MyPanel&gt;() { new MyPanel(P.p) };
            PL.AddRange(Panels.Where(a =&gt; a.cn.name == P.p.CustomName).OrderBy(a =&gt; a.cn.order).Select(a =&gt; new MyPanel(a.p)));
            G = new LCDGroup(PL, P.cn.name, GridTerminalSystem);
        }
        else
        {
            var PL = new List&lt;MyPanel&gt;() { G.Panels[0] };
            var SPL = Panels.Where(a =&gt; a.cn.name == P.p.CustomName).OrderBy(a =&gt; a.cn.order).Select(a =&gt; a.p).ToArray();

            foreach (var p in SPL)
            {
                var ep = G.Panels.SingleOrDefault(a =&gt; a.Lcd.Equals(p));
                        
                PL.Add((ep != null) ? ep : new MyPanel(p));
            }
            G.Panels = PL;
        }

        nList.Add(G);
    }

    var SB = Blocks.Where(a =&gt; a is IMyTextSurfaceProvider &amp;&amp; !(a is IMyTextPanel)).ToArray();
    var SL = new List&lt;TextSurfaceInfo&gt;();
    foreach (var B in SB) SL.AddRange(LCDConfig.SurfaceFromConfig(B));
    foreach (var S in SL.Where(a =&gt; a.Cargo.name != "").OrderBy(a=&gt;a.Cargo.order).GroupBy(a =&gt; new { a.Block, a.Cargo.name }))
    {
        var G = Groups.SingleOrDefault(a =&gt; a.Panels.All(b =&gt; b.Block.Equals(S.Key.Block)) &amp;&amp; a.CargoName == S.Key.name);
        if (G == null)
        {
            G = new LCDGroup(S.Select(a =&gt; new MyPanel(a.Surface, a.Block, a.Index)).ToList(), S.Key.name, GridTerminalSystem);
        }
        else
        {
            var PL = new List&lt;MyPanel&gt;();
            foreach (var p in S)
            {
                var ep = G.Panels.SingleOrDefault(a =&gt; a.Block.Equals(p.Block) &amp;&amp; a.SurfaceIndex == p.Index);
                PL.Add((ep != null) ? ep : new MyPanel(p.Surface, p.Block, p.Index));               
            }
            G.CargoName = S.Key.name;
            G.Panels = PL;
        }
        nList.Add(G);
    }

    Groups.Clear();
    Groups.AddRange(nList);
    var info = string.Format("Found {0} LCDs Groups", Groups.Count);
    Echo(info);
    ShowLogo(info);
}

void DoWork()
{
    DateTime update_limit = DateTime.Now.AddSeconds(-1);
    var GL = Groups.Where(a =&gt; a.LastShown &lt; update_limit).OrderBy(a =&gt; a.LastShown).Take(1).ToArray();
    foreach (LCDGroup G in GL) { G.DoWork(); }
}

bool decoded = false;

void Decode()
{
    foreach (var e in Font_enc) Font.Add(e.Key, RLE_Decode(e.Value).Split('\uE070'));
    foreach (var e in SFont_enc) SFont.Add(e.Key, RLE_Decode(e.Value).Split('\uE070'));
    foreach (var e in Images_enc) Images.Add(e.Key.ToLower(), RLE_Decode(e.Value).Split('\uE070'));
    decoded = true;
}

bool custom_decoded = false;

void DecodeCustomImages()
{
    if (Me.CustomData == string.Empty) { custom_decoded = true; return; }

    var entries = Me.CustomData.Split(new char[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
    var r = new System.Text.RegularExpressions.Regex(@"([\w ]+_\w+)#([0-9\uE070\uE100-\uE2FF]+)");

    foreach (string e in entries)
    {
        if (r.IsMatch(e))
        {
            var m = r.Match(e);
            string ItemId = m.Groups[1].Value.ToLower();
            string[] Image = RLE_Decode(m.Groups[2].Value).Split('\uE070');

            if (Image.Length == 32 &amp;&amp; Image.All(a =&gt; a.Length == 32))
            {
                if (Images.ContainsKey(ItemId)) Images[ItemId] = Image;
                else Images.Add(ItemId, Image);
            }
        }
    }

    custom_decoded = true;
}

public static string RLE_Decode(string input)
{
    return System.Text.RegularExpressions.Regex.Replace(input, @"(\d*)(\D)",
        m =&gt; new string(m.Groups[2].Value[0], (m.Groups[1].Value == "") ? 1 : int.Parse(m.Groups[1].Value)));
}

LCDGraphics PB = null;

void ShowLogo(string Info)
{
    if (PB == null) PB = new LCDGraphics(178, 178);
    PB.DrawImage(0, 0, Images["logo"]);
    var Lcd = Me.GetSurface(0);
    if (Lcd.ContentType != ContentType.TEXT_AND_IMAGE) Lcd.ContentType = ContentType.TEXT_AND_IMAGE;
    if (Lcd.Font != "Monospace") Lcd.Font = "Monospace";
    if (Lcd.FontSize != 0.1f) Lcd.FontSize = 0.1f;
    if (Lcd.TextPadding != 0) Lcd.TextPadding = 0;
    if (Lcd.FontColor == Color.White) Lcd.FontColor = Color.Gray;
    PB.DrawText(89, 70, Info, true, Colors["black"]);
    string output = PB.GetImage();
    if (output != Lcd.GetText()) Lcd.WriteText(output);
}

public class LCDGroup
{
    public DateTime LastShown { get { return Panels.Min(a =&gt; a.LastShown); } }
    public int Mode { get; private set; }
    public List&lt;MyPanel&gt; Panels { get; set; }
    public string CargoName { get; set; }

    IMyGridTerminalSystem GTS;

    public LCDGroup(List&lt;MyPanel&gt; panels, string cargo, IMyGridTerminalSystem gts)
    {
        GTS = gts;
        Mode = 0;
        Panels = panels;
        CargoName = cargo;
    }

    public void DoWork()
    {
        switch (Mode)
        {
            case 0: Collect(); break;
            case 1: Prepare(); break;
            case 2: Show(); break;
        }
    }

    void Collect()
    {
        Mode = 1;
        if (CargoName != string.Empty)
        {
            Panels[0].UpdateConfig(new LCDConfig());
            foreach (var P in Panels.Skip(1)) { P.UpdateConfig(Panels[0].C); }
            IMyTerminalBlock Cargo = GTS.GetBlockWithName(CargoName);
            if (Cargo != null) GetInventory(Cargo);
            else
            {
                var Group = GTS.GetBlockGroupWithName(CargoName);
                if (Group != null) GetInventory(Group);
                else ShowError("Block not found");
            }
        }
        else { ShowError("Please enter the name"); }
    }

    void Prepare()
    {
        var PL = Panels.Where(w =&gt; !w.Ready).Take(3);
        foreach (var P in PL) { FillTable(P); }
        if (Panels.All(a =&gt; a.Ready)) Mode = 2;
    }

    void Show()
    {
        Mode = 0;
        foreach (MyPanel P in Panels) { P.Show(); P.Reset(); }
    }

    void GetInventory(IMyBlockGroup group)
    {
        List&lt;IMyTerminalBlock&gt; Blocks = new List&lt;IMyTerminalBlock&gt;();
        group.GetBlocks(Blocks);

        var inv1_items = new List&lt;MyInventoryItem&gt;();
        var inv2_items = new List&lt;MyInventoryItem&gt;();

        double total_volume = 0, total_mass = 0;
        bool has_production = Blocks.All(a =&gt; a is IMyAssembler) || Blocks.All(a =&gt; a is IMyRefinery);

        foreach (IMyTerminalBlock B in Blocks)
        {
            if (!B.HasInventory) continue;

            for (int i = 0; i &lt;= 1; i++)
            {
                IMyInventory inv = B.GetInventory(i);
                if (inv != null)
                {
                    List&lt;MyInventoryItem&gt; IL = new List&lt;MyInventoryItem&gt;();
                    inv.GetItems(IL);
                    total_volume += (double)inv.CurrentVolume;
                    total_mass += (double)inv.CurrentMass;
                    ((i == 0) ? inv1_items : inv2_items).AddRange(IL);
                }
            }
        }

        var items = new InventoryItem[0];
        var items2 = new InventoryItem[0];

        if (has_production)
        {
            items = inv1_items.GroupBy(a =&gt; InventoryItem.GetItemID(a))
                    .Select(g =&gt; new InventoryItem(g.Key, g.Sum(a =&gt; (double)a.Amount))).ToArray();
            items2 = inv2_items.GroupBy(a =&gt; InventoryItem.GetItemID(a))
                    .Select(g =&gt; new InventoryItem(g.Key, g.Sum(a =&gt; (double)a.Amount))).ToArray();
        }
        else
        {
            var all_items = new List&lt;MyInventoryItem&gt;(inv1_items);
            all_items.AddRange(inv2_items);

            items = all_items.GroupBy(a =&gt; InventoryItem.GetItemID(a))
                    .Select(g =&gt; new InventoryItem(g.Key, g.Sum(a =&gt; (double)a.Amount))).ToArray();
        }

        FillPanelItems(items, items2, has_production, group.Name, GetCargoPercent(Blocks), total_volume, total_mass);
    }

    void GetInventory(IMyTerminalBlock block)
    {
        if (!block.HasInventory &amp;&amp; !(block is IMyCockpit))
        {
            ShowError("Block has no inventory");
            return;
        }

        bool has_production = block is IMyAssembler || block is IMyRefinery;

        IMyInventory inv = block.GetInventory(0);
        IMyInventory inv2 = block.GetInventory(1);

        if (inv != null)
        {
            List&lt;MyInventoryItem&gt; IL = new List&lt;MyInventoryItem&gt;();
            inv.GetItems(IL);

            InventoryItem[] items = IL.Select(a =&gt; new InventoryItem(a)).ToArray();
            InventoryItem[] items2 = new InventoryItem[0];

            double total_volume = (double)inv.CurrentVolume;
            double total_mass = (double)inv.CurrentMass;
            if (inv2 != null)
            {
                List&lt;MyInventoryItem&gt; IL2 = new List&lt;MyInventoryItem&gt;();
                inv2.GetItems(IL2);
                items2 = IL2.Select(a =&gt; new InventoryItem(a)).ToArray();
                total_volume += (double)inv2.CurrentVolume;
                total_mass += (double)inv2.CurrentMass;
            }

            FillPanelItems(items, items2, has_production, block.CustomName, GetCargoPercent(inv), total_volume, total_mass);
        }
    }

    void FillPanelItems(InventoryItem[] Inv1, InventoryItem[] Inv2, bool HasProduction,
        string Title, double CargoPercent, double total_volume, double total_mass)
    {
        if (HasProduction)
        {
            if (Panels.Count &gt; 1) Panels[1].Title = "Production";
            Panels[0].Items = Inv1;

            int pt = 0;
            for (int i = 1; i &lt; Panels.Count; i++)
            {
                int pi = Panels[i].C.rows * Panels[i].C.cols * (Panels[i].IsWide ? 2 : 1);
                Panels[i].Items = Inv2.Skip(pt).Take((i &lt; Panels.Count - 1) ? pi : Inv2.Length - pt).ToArray();
                pt += pi;
            }
        }
        else
        {
            int pt = 0;
            for (int i = 0; i &lt; Panels.Count; i++)
            {
                int pi = Panels[i].C.rows * Panels[i].C.cols * (Panels[i].IsWide ? 2 : 1);
                Panels[i].Items = Inv1.Skip(pt).Take((i &lt; Panels.Count - 1) ? pi : Inv1.Length - pt).ToArray();
                pt += pi;
            }
        }

        Panels[0].PBarValue = CargoPercent;
        Panels[0].Title = Title;

        if (Panels.Count == 2)
        {
            Panels[1].Footer = string.Format("Mass: {0:F0} kg  Vol: {1:F0} L", total_mass, (total_volume * 1000));
        }
        else if (Panels.Count &gt; 2)
        {
            string m = string.Format("Mass:  {0:F2} kg", total_mass);
            string v = string.Format("Volume:  {0:F2} L", (total_volume * 1000));

            if (Panels[1].IsWide)
            {
                Panels[1].Footer = string.Format("{0}     {1}", m, v);
            }
            else
            {
                Panels[1].Footer = m;
                Panels[2].Footer = v;
            }
        }
    }

    void DrawTable(MyPanel P)
    {
        int Cols=P.C.cols,Rows=P.C.rows,w=3+35*Cols*(P.IsWide?2:1),y=2;

        if (((Rows==4&amp;&amp;Cols==5)||(Rows&lt;5&amp;&amp;P.C.title!=string.Empty))&amp;&amp;Cols&gt;=2)
        {
            P.G.DrawRectangle(0,0,w,158,P.C.bordercolor);
            P.G.DrawFilledRectangle(0,0,w,16,P.C.headercolor);
            P.G.DrawRectangle(0,0,w,16,P.C.bordercolor);
            y=17;           
        }
        else P.G.DrawRectangle(0,0,w,3+35*Rows,P.C.bordercolor);

        for (int c=0; c&lt;Cols*(P.IsWide?2:1); c++)
        {
            for (int r=0; r&lt;Rows; r++)
            {
                P.G.DrawFilledRectangle(3+c+34*c,y+1+r+34*r,32,32,P.C.emptycellcolor);
                P.G.DrawRectangle(2+c+34*c,y+r+34*r,34,34,P.C.bordercolor);
            }
        }
    }

    void FillTable(MyPanel P)
    {
        int Cols=P.C.cols,Rows=P.C.rows,y=3,w=3+35*Cols*(P.IsWide?2:1);
        P.G.Clear(P.C.backgroundcolor);
        DrawTable(P);
        bool dt=(((Rows==4&amp;&amp;Cols==5)||(Rows&lt;5&amp;&amp;P.C.title!=""))&amp;&amp;Cols&gt;=2);

        if (dt&amp;&amp;(P.Title!=""||P.C.title!=""))
        {
            P.G.DrawText(w/2, 2, (P.C.title!="") ? P.C.title : P.Title, true, P.C.headercolor);
            y = 18;
        }
        if (Rows==4&amp;&amp;Cols==5&amp;&amp;P.Footer!="")
        {
            y = 18;
            P.G.DrawText(P.IsWide ? 176 : 89, 162, P.Footer, true, P.C.backgroundcolor);
        }

        if (P.Items != null)
        {
            int r = 0; int c = 0; int count = 0; int cc = Cols * Rows * (P.IsWide ? 2 : 1);
            foreach (var item in P.Items)
            {
                if (c == Cols * (P.IsWide ? 2 : 1)) { c = 0; r++; if (r &gt; Rows) break; }
                count++;

                if (count == cc &amp;&amp; P.Items.Length &gt; cc)
                {
                    P.G.DrawFilledRectangle(5 + c * 35, y + r * 35 + 2, 28, 28, P.C.bordercolor);
                    P.G.DrawFilledRectangle(8 + c * 35, y + r * 35 + 5, 22, 22, P.C.backgroundcolor);
                    P.G.DrawText(19 + c * 35, y + r * 35 + 10, string.Format("+{0}", P.Items.Length - cc + 1), true, P.C.backgroundcolor);
                    break;
                }
                else
                {
                    P.G.DrawFilledRectangle(3 + c * 35, y + r * 35, 32, 32, P.C.cellcolor);
                    P.G.DrawImage(3 + c * 35, y + r * 35, Images.ContainsKey(item.ItemId) ?
                        Images[item.ItemId] : Images["unknown"], '\uE153', P.C.cellcolor);
                    P.G.DrawNumber(4 + c * 35, y + 23 + r * 35, item.Amount, false);
                }
                c++;
            }
        }

        if (Rows == 4 &amp;&amp; Cols == 5 &amp;&amp; Panels.IndexOf(P) == 0)
        {
            DrawProgressBar(P, 2, 162, P.IsWide ? 306 : 127, 12, P.PBarValue);
            Panels[0].G.DrawText(P.IsWide ? 313 : 134, 162, (P.PBarValue &gt;= 100) ? "100 %" : string.Format("{0:F2} %", P.PBarValue), false, P.C.backgroundcolor);
        }

        P.Ready = true;
    }

    void DrawProgressBar(MyPanel Panel, int x, int y, int width, int height, double value)
    {
        int bar_w = Convert.ToInt32(((double)width - 2) / 100 * value);
        Panel.G.DrawRectangle(x, y, width, height, Panel.C.bordercolor);
        Panel.G.DrawFilledRectangle(x + 1, y + 1, bar_w, height - 2, Panel.C.progressbarcolor);
    }

    double GetCargoPercent(IMyInventory inv)
    {
        double usedAmount = (double)inv.CurrentVolume;
        double totalAmount = (double)inv.MaxVolume;
        return (totalAmount &gt; 0 ? (usedAmount / totalAmount) * 100 : 100);
    }

    double GetCargoPercent(List&lt;IMyTerminalBlock&gt; Blocks)
    {
        double usedAmount = 0;
        double totalAmount = 0;

        foreach (IMyTerminalBlock B in Blocks)
        {
            if (!B.HasInventory) continue;
            IMyInventory inv = B.GetInventory(0);
            usedAmount += (double)inv.CurrentVolume;
            totalAmount += (double)inv.MaxVolume;
        }
        return (totalAmount &gt; 0 ? (usedAmount / totalAmount) * 100 : 100);
    }

    public void ShowError(string error)
    {
        foreach (MyPanel P in Panels)
        {
            P.G.Clear(P.C.backgroundcolor);
            P.G.DrawText(P.G.Width / 2, (P.G.Height / 2) - 6, error, true);
            P.Show();
        }
        Mode = 0;
    }
}

public class MyPanel
{
public LCDGraphics G{get;private set;}
public IMyTerminalBlock Block{get;}
public IMyTextSurface Lcd{get;}
public int SurfaceIndex{get;}
public string Title{get;set;}
public string Footer{get;set;}
public double PBarValue{get;set;}
public InventoryItem[] Items{get;set;}
public bool Ready{get;set;}
public LCDConfig C{get;private set;}
public DateTime LastShown{get;private set;}
public bool IsWide{get;}

float Scale;
static float[] Scales = new float[] {0.465f,0.244f,0.165f,0.124f,0.1f};

public MyPanel(IMyTextSurface Lcd, IMyTerminalBlock Block, int Index)
{
this.Lcd=Lcd;
this.Block=Block;
SurfaceIndex=Index;
IsWide=Block.BlockDefinition.SubtypeId.Contains("Wide");
G=new LCDGraphics(IsWide?353:178,178);
Scale=0.1f;
C=new LCDConfig();
Title=string.Empty;
Footer=string.Empty;
PBarValue=0;
Items=null;
Ready=false;
LastShown=DateTime.Now.Date;
}

public MyPanel(IMyTerminalBlock Lcd) : this((IMyTextSurface)Lcd, Lcd, 0) { }

public void Reset()
{
Title=string.Empty;
Footer=string.Empty;
PBarValue=0;
Items=null;
Ready=false;
}

public void Show()
{
if (Lcd.ContentType != ContentType.TEXT_AND_IMAGE) Lcd.ContentType = ContentType.TEXT_AND_IMAGE;
if (Lcd.Font != "Monospace") Lcd.Font = "Monospace";
if (C.autoscale &amp;&amp; Lcd.FontSize != Scale) Lcd.FontSize = Scale;
if (C.autoscale &amp;&amp; Lcd.TextPadding != 0) Lcd.TextPadding = 0;
if (Lcd.FontColor == Color.White) Lcd.FontColor = (Block is IMyTextPanel) ? Color.Gray : Color.LightGray;
if (C.autoscale &amp;&amp; Lcd.Alignment != TextAlignment.CENTER) Lcd.Alignment = TextAlignment.CENTER;

string output = G.GetImage();
Lcd.WriteText(output);
LastShown = DateTime.Now;
}

public void UpdateConfig(LCDConfig Prototype)
{
C = LCDConfig.Parse(Block, SurfaceIndex, Prototype);
bool dt=(((C.rows==4&amp;&amp;C.cols==5)||(C.rows&lt;5&amp;&amp;C.title!=""))&amp;&amp;C.cols&gt;=2),dp=(C.cols==5&amp;&amp;C.rows==4);
int h = ((dt)?18:3)+35*C.rows+((dp)?20:0),w=3+35*C.cols*(IsWide?2:1);
if (G.Width!=w||G.Height!=h)
{
G = new LCDGraphics(w, h);
Scale = Scales[C.cols - 1];
}
}
}

public class LCDGraphics
{
    public int Width {get;}
    public int Height {get;}

    string[] Image;
    char backcolor;

    public LCDGraphics(int width, int height)
    {
        Width = width;
        Height = height;
        Image = new string[height];
        backcolor = Colors["black"];
        Clear();
    }

    public string GetImage()
    {
        return string.Join("\n", Image);
    }

    public void Clear()
    {
        Clear(backcolor);
    }

    public void Clear(char color)
    {
        for (int r=0;r&lt;Height;r++) Image[r]=new string(color,Width);
    }

    public void DrawText(int x, int y, string text, bool center = false, char background = '\uE153')
    {
        int rows_count = Font.Max(a =&gt; a.Value.Length);
        string[] res = new string[rows_count];

        foreach (char ch in text)
        {
            var SL = Font.ContainsKey(ch)?Font[ch]:Font['?'];
            for (int r=0;r&lt;rows_count;r++) if (r&lt;SL.Length) res[r]+=SL[r];
        }

        if (center)
        {
            int str_w = res[0].Length, nx = Convert.ToInt32(x-(double)str_w/2);
            DrawImage((nx&gt;0)?nx:0,y,res,'\uE153',background);
        }
        else DrawImage(x,y,res,'\uE153',background);
    }

    public void DrawNumber(int x, int y, double value, bool center = false)
    {
        string text=FormatNumber(value);
        string[] res=new string[9];
        foreach (char ch in text)
        {
            var SL=SFont.ContainsKey(ch)?SFont[ch]:SFont[' '];
            for (int r=0;r&lt;9;r++) if (r&lt;SL.Length) res[r]+=SL[r];
        }

        if (center) { int str_w=res[0].Length, nx=x-str_w/2; DrawImage((nx&gt;0)?nx:0,y,res,'\uE100'); }
        else DrawImage(x,y,res,'\uE100');
    }

    static string FormatNumber(double num)
    {
        if (num&gt;=100000) return FormatNumber(num/1000)+"k";
        if (num&gt;=1000) return (num/1000D).ToString("0.#")+"k";
        return num.ToString("#,0");
    }

    public void DrawRectangle(int x, int y, int rwidth, int rheight, char color)
    {
        int max_y=(y+rheight&lt;Height)?y+rheight:Height, nw=(x+rwidth&lt;Width)?rwidth:Width-x;
        for (int r=y;r&lt;max_y;r++)
        {
            if (r==y||r==max_y-1)Image[r]=Image[r].Remove(x,nw).Insert(x,new string(color,nw));
            else
            {
                Image[r]=Image[r].Remove(x,1).Insert(x,color.ToString());
                if (x+rwidth&lt;=Width) Image[r]=Image[r].Remove(x+rwidth-1,1).Insert(x+rwidth-1,color.ToString());
            }
        }
    }

    public void DrawFilledRectangle(int x, int y, int rwidth, int rheight, char color)
    {
        int max_y=(y+rheight&lt;Height)?y+rheight:Height, nw=(x+rwidth&lt;Width)?rwidth:Width-x;
        for (int r=y;r&lt;max_y;r++) Image[r]=Image[r].Remove(x,nw).Insert(x,new string(color,nw));
    }

    public void DrawImage(int x, int y, string[] img)
    {
        int img_w=img[0].Length, img_h=img.Length;
        int max_y=(y+img_h&lt;Height)?y+img_h:Height;
        int nw=(x+img_w&lt;Width)?img_w:Width-x;
        for (int r=y; r&lt;max_y; r++) Image[r]=Image[r].Remove(x,nw).Insert(x,img[r-y].Substring(0,nw));
    }

    public void DrawImage(int x, int y, string[] img, char oldchar, char newchar)
    {
        if (oldchar!=newchar) DrawImage(x,y,string.Join(",",img).Replace(oldchar,newchar).Split(','));
        else DrawImage(x,y,img);
    }

    public void DrawImage(int x, int y, string[] img, char transparent)
    {
        int img_w=img[0].Length, img_h=img.Length;
        int max_y=(y+img_h&lt;Height)?y+img_h:Height;
        int nw=(x+img_w&lt;Width)?img_w:Width-x;

        for (int r=y;r&lt;max_y;r++)
        {
            char[] str=Image[r].ToCharArray(x,nw), nstr=img[r-y].ToCharArray(0,nw);
            for (int c=0;c&lt;nw;c++) if (nstr[c]!=transparent) str[c]=nstr[c];
            Image[r]=Image[r].Remove(x,nw).Insert(x, new string(str));
        }
    }
}

public struct InventoryItem
{
public double Amount{get;}
public string ItemId{get;}

public InventoryItem(MyInventoryItem item)
{
Amount=(double)item.Amount;
ItemId=GetItemID(item);
}

public InventoryItem(string ItemId, double Amount)
{
this.ItemId=ItemId;
this.Amount=Amount;
}

public static string GetItemID(MyInventoryItem item)
{
string typeid=item.Type.TypeId.ToString();
typeid=typeid.Substring(typeid.LastIndexOf('_')+1);
return string.Concat(item.Type.SubtypeId,"_",typeid).ToLower();
}
}

public struct CName
{
    public string name; public int order;
    public CName (string n, int o) { name = n; order = o; }
}

public struct TextSurfaceInfo
{
    public IMyTerminalBlock Block;  public int Index; public IMyTextSurface Surface; public string Data; public CName Cargo;
    public TextSurfaceInfo(IMyTerminalBlock B, int I, IMyTextSurface S, string D, CName C) { Block = B; Index = I; Surface = S; Data = D; Cargo = C; }
}

public class LCDConfig
{
public char backgroundcolor {get;set;}
public char bordercolor {get;set;}
public char headercolor {get;set;}
public char cellcolor {get;set;}
public char emptycellcolor {get;set;}
public char progressbarcolor {get;set;}
public string title {get;set;}
public int rows {get;set;}
public int cols {get;set;}
public bool autoscale {get;set;}

public LCDConfig()
{
backgroundcolor='\uE153';
bordercolor='\uE1A6';
headercolor='\uE153';
cellcolor='\uE153';
emptycellcolor='\uE153';
progressbarcolor='\uE10A';
title=string.Empty;
rows=4;
cols=5;
autoscale=true;
}

public static TextSurfaceInfo[] SurfaceFromConfig(IMyTerminalBlock B)
{
var R = new List&lt;TextSurfaceInfo&gt;();
if (!(B is IMyTextSurfaceProvider)) return R.ToArray();
var P = (IMyTextSurfaceProvider)B;

var mc = new System.Text.RegularExpressions.Regex(@"\[LCD\s*(\d+)]\r*\n*([^\[]*)").Matches(B.CustomData);
if (mc.Count == 0) return R.ToArray();
foreach (System.Text.RegularExpressions.Match m in mc)
{
int n = toInt(m.Groups[1].Value);
if (n &gt; 0 &amp;&amp; n &lt;= P.SurfaceCount &amp;&amp; !R.Any(a=&gt;a.Index==n-1)) R.Add(new TextSurfaceInfo(B, n-1, P.GetSurface(n-1), m.Groups[2].Value, CargoNameFromConfig(m.Groups[2].Value)));
}
return R.ToArray();
}

public static CName CargoNameFromConfig(string CD)
{
var n = new System.Text.RegularExpressions.Regex(@"^([^:\r\n]*)\s*\:*\s*(\d*)(?:\r|\n|$|;)").Match(CD);
return n.Success ? new CName(n.Groups[1].Value, toInt(n.Groups[2].Value)) : new CName("", 0);
}

public static LCDConfig Parse(IMyTerminalBlock TB, int I, LCDConfig Prototype = null)
{
var C = (Prototype == null) ? new LCDConfig() : Prototype.Clone();
string Data = (TB is IMyTextPanel) ? Data = TB.CustomData : SurfaceFromConfig(TB).FirstOrDefault(a =&gt; a.Index == I).Data;
C.title = string.Empty;
C.autoscale = true;
var r = new System.Text.RegularExpressions.Regex(@"(?m)^\s*(\w+)\s*=\s*(.*)\s*(?=\r?$)");

foreach (System.Text.RegularExpressions.Match m in r.Matches(Data))
{
string v = m.Groups[2].Value.Trim(new char[] { ' ', '\"' });

switch (m.Groups[1].Value)
{
case "backgroundcolor":
if (Colors.ContainsKey(v)) C.backgroundcolor = Colors[v];break;
case "bordercolor":
if (Colors.ContainsKey(v)) C.bordercolor = Colors[v];break;
case "headercolor":
if (Colors.ContainsKey(v)) C.headercolor = Colors[v];break;
case "cellcolor":
if (Colors.ContainsKey(v)) C.cellcolor = Colors[v];break;
case "emptycellcolor":
if (Colors.ContainsKey(v)) C.emptycellcolor = Colors[v];break;
case "progressbarcolor":
if (Colors.ContainsKey(v)) C.progressbarcolor = Colors[v];break;
case "title":
C.title = v;break;
case "size":
int[] size = v.Split('x').Select(a =&gt; toInt(a)).ToArray();
if (size.Length == 2) {C.rows=(size[1]&gt;=1&amp;&amp;size[1]&lt;=5)?size[1]:4; C.cols=(size[0]&gt;=1&amp;&amp;size[0]&lt;=5)?size[0]:5;}break;
case "autoscale":
C.autoscale = !(v == "false");break;
}
}
return C;
}
   
static int toInt(string s)
{
int r=0; int.TryParse(s, out r); return r;
}

public LCDConfig Clone()
{
return (LCDConfig)MemberwiseClone();
}
