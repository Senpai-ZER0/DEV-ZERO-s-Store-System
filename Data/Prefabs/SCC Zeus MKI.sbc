                            <Value>;  IMPORTANT! The script must be recompiled to
;  apply any configuration changes.

[PowerGraphs]
;  The text LCD names must contain to be used
Lcd_Name_Tag=[PowerGraph]

;  The text sensor names must contain if
;  they are to be used as LCD triggers
Sensor_Name_Tag=[LCDTrigger]

;  How often current power stats are collected
Data_Update_Interval_In_Seconds=60

;  How often LCDs are redrawn
;  WARNING: Times below one second may impact game performance
LCD_Refresh_Interval_In_Seconds=10

;  Should LCDs without a specific display
;  type cycle through all display types
Auto_Cycle_Graphs=True

;  How often LCDs cycle between assigned graph types
Auto_Cycle_Interval_In_Seconds=10

;  When enabled the script will insert empty sections after a power outage
;  for the duration of the outage.
;  NOTE: Pausing the game will have the same effect as a power outage.
;  If you aren't likely to experience frequent power outages and you pause
;  the game often you may want to set this to false.
Zero_Fill_Missing_Values=True

;  Should the script update LCDs on attached grids (through rotors,
;  connectors, pistons, etc.)
Display_On_LCDs_Of_Attached_Grids=False

;  Should the script update LCDs on grids attached via connectors
Display_On_LCDs_Of_Grids_Attached_Via_Connectors=False

;  Should power and gas be included from grids attached via connectors
Include_Data_From_Grids_Attached_Via_Connectors=False

;  Should power and gas of attached small grids be read
Include_Data_From_Attached_Small_Grids=False

;  Should power and gas of attached large grids be read
Include_Data_From_Attached_Large_Grids=False

;  Set to true to enable collecting of gas tank information
Measure_Stored_Gas=False

;  Set to true to record more data points (2x). These will only be
;  shown on wide LCDs. This will use more memory and performance.
Enable_Long_History=False

;  Set to false to disable the script status display output on the
;  programmable blocks screen
Show_Script_Status_On_PB_Display=True

Script_Status_Display_Surface_Index=0

Color_Brightness=0.5

;  Extra padding around the edge of displays. Try 15 as an example.
Margin=0
</Value>
                          </item>
                        </dictionary>
                      </Storage>
                    </Component>
                  </ComponentData>
                </Components>
